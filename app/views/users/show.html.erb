<div class="show-wrapper">
  <div class="detail-container user-show-container">
    <h2>マイページ</h2>

    <!-- プロフィールカード -->
    <div class="profile-card">
      <div class="profile-header">
        <div class="profile-avatar">
          <% if @user.image.attached? %>
            <%= image_tag @user.image, class: "avatar-img" %>
          <% else %>
            <div class="default-avatar">👤</div>
          <% end %>
        </div>
        <div class="profile-details">
          <h3 class="user-name"><%= @user.name %></h3>
          <p class="user-email"><%= @user.email %></p>
        </div>
      </div>

      <div class="profile-bio">
        <span class="label">プロフィール</span>
        <p class="bio-text"><%= @user.profile.presence || "プロフィール文は未設定です。" %></p>
      </div>

      <% if current_user.id == @user.id %>
        <div class="profile-edit-btn">
          <%= link_to "プロフィールを編集する", edit_user_registration_path, class: "btn-edit-action" %>
        </div>
      <% end %>
    </div>

    <!-- ユーザーの投稿一覧 -->
    <div class="user-tweets-section">
      <h3><%= @user.name %> さんの投稿一覧</h3>

      <% if @user.tweets.present? %>
        <div class="user-tweet-list">
          <% @user.tweets.each do |t| %>
            <div class="tweet-card">
              <div class="tweet-card-header">
                <span class="spot-name"><%= t.spot_name %></span>
                <span class="tag-who"><%= t.who %></span>
              </div>
              <div class="tweet-card-body">
                <p class="tweet-info">📍 <%= t.address %> ｜ ⏱ <%= t.time %></p>
                <% if t.experience.present? %>
                  <p class="tweet-text"><strong>感想:</strong> <%= t.experience %></p>
                <% end %>
                <% if t.advice.present? %>
                  <p class="tweet-text"><strong>アドバイス:</strong> <%= t.advice %></p>
                <% end %>
              </div>
              <div class="tweet-card-footer">
                <%= link_to "詳細を見る", tweet_path(t.id), class: "btn-sm btn-detail" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="no-tweets">まだ投稿はありません。</p>
      <% end %>
    </div>

    <div class="back-link-container">
      <%= link_to "← Tweet一覧に戻る", tweets_path, class: "back-link" %>
    </div>
  </div>
</div>